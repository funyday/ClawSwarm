# ============================================
# Tailscale 容器配置 (可选)
# ============================================
# 
# 要启用 Tailscale 容器，请：
#
# 1. 在 docker-compose.yml 中取消注释 tailscale 服务部分
#
# 2. 从 Tailscale 控制台获取认证密钥:
#    https://login.tailscale.com/admin/settings/keys
#
# 3. 在 .env 文件中设置:
#    TAILSCALE_AUTH_KEY=tskey-auth-k缩短XXXXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
#
# 4. 重新部署:
#    docker-compose down && docker-compose up -d
#
# ============================================

# Tailscale 认证密钥 (必需)
TAILSCALE_AUTH_KEY=

# 额外参数 (可选)
# TS_EXTRA_ARGS=--accept-dns=false
