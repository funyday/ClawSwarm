# ClawSwarm 环境变量配置
# 复制此文件为 .env 并修改相应值

# ============================================
# 数据库配置
# ============================================
DB_PASSWORD=your_secure_password_here

# ============================================
# 应用配置
# ============================================
# 应用程序的基础 URL（用于飞书回调等）
CLAWSWARM_BASE_URL=https://your-domain.com

# 加密密钥（生产环境请使用随机生成的密钥）
SECRET_KEY=change-me-to-a-random-secret-key-in-production

# 日志级别
LOG_LEVEL=INFO

# ============================================
# Headscale 配置 (可选)
# ============================================
# Headscale 服务器地址
HEADSCALE_URL=https://headscale.example.com

# Headscale API Key
HEADSCALE_API_KEY=your_headscale_api_key

# ============================================
# Tailscale 配置 (可选)
# ============================================
# Tailscale 认证密钥 (从 Tailscale 控制台获取)
# 格式: tskey-auth-k缩短XXXXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TAILSCALE_AUTH_KEY=

# ============================================
# 飞书配置 (可选)
# ============================================
# 飞书应用 App ID
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx

# 飞书应用 App Secret
FEISHU_APP_SECRET=your_feishu_app_secret
